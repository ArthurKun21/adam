{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "semanticCommits": "disabled",
    "extends": [
        "config:recommended",
        ":dependencyDashboard",
        ":enablePreCommit"
    ],
    "pre-commit": {
        "enabled": true
    },
    "packageRules": [
        {
            "description": "Kotlin version-catalog plugin ids share the kotlin version ref; same hold as the org.jetbrains.kotlin:* rule.",
            "matchPackageNames": [
                "org.jetbrains.kotlin.jvm",
                "org.jetbrains.kotlin.plugin.serialization",
                "org.jetbrains.kotlin.plugin.compose"
            ]
        },
        {
            "description": "Maintain uv.lock (docs site dependencies managed by uv); pyproject.toml direct deps are covered by the pep621 manager.",
            "matchManagers": [
                "uv"
            ],
            "lockFileMaintenance": {
                "enabled": true
            }
        },
        {
            "matchManagers": [
                "pre-commit"
            ],
            "groupName": "pre-commit hooks",
            "automerge": true,
            "matchUpdateTypes": [
                "minor",
                "patch"
            ]
        }
    ]
}
